
# ==========================================================
# APEXIVEAI COMMUNITY
# ENVIRONMENT TEMPLATE
# ==========================================================

APP_ENV=production
DEBUG=false
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/DATABASE

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=https://apexiveai.com,https://www.apexiveai.com

# Nginx
NGINX_PORT=8080

# Backup
BACKUP_DIR=./backups
RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO

# Monitoring
ENABLE_METRICS=false

# External services
# Add actual project-specific variables here.
