APP_NAME=ApexiveAI Community
APP_VERSION=1.0.0
ENVIRONMENT=production

API_PREFIX=/api

DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/apexive_community_app

JWT_SECRET_KEY=<NEW_RANDOM_SECRET_64_BYTES>
JWT_ALGORITHM=HS256
JWT_ISSUER=ApexiveAI
JWT_AUDIENCE=apexiveai-solutions

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=https://www.apexiveai.com

CORS_ORIGINS=https://www.apexiveai.com,https://apexiveai.com
CORS_ORIGIN_REGEX=^https://apexiveai-s-everywhere-[a-z0-9-]+-apexiveais-projects\.vercel\.app$

# Optional; the backend currently defaults to local Redis.
REDIS_URL=redis://localhost:6379/0

TRADEMARK_CONFLICT_API_URL=https://apexiveai-trademark-detection.onrender.com

APEXIVE_RPA_API_URL=https://apexiveai-robotic-process-automation.onrender.com

WORKFORCE_AI_API_URL=
MNA_AI_API_URL=

LICENSE_SECRET_KEY=<NEW_RANDOM_LICENSE_SECRET>
LICENSE_ISSUER=ApexiveAI

# Used by the Dockerfile and backend Procfile; Render may set this per service.
PORT=8000