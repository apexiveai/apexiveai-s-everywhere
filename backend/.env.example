AI_LOCAL_MODEL=

# Generation
AI_REQUEST_TIMEOUT=120
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Access
AI_PUBLIC_ACCESS_ENABLED=true
AI_TENANT_ACCESS_ENABLED=true

# Limits
AI_MAX_MESSAGE_LENGTH=20000
AI_MAX_HISTORY_MESSAGES=30
