# ==========================================
# APEXIVEAI UNIVERSAL AI AGENT
# ==========================================

AI_ENABLED=true
AI_DEFAULT_PROVIDER=cloud

# Cloud AI - OpenAI Compatible Endpoint
AI_CLOUD_BASE_URL=
